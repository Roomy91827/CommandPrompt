G2L["23"]["BackgroundTransparency"] = 0.6;


-- StarterGui.UserAccountControlGUI.Client
local function C_2()
local script = G2L["2"];
	local Players = game:GetService("Players")
	local TweenService = game:GetService("TweenService")
	local CoreGui = game:WaitForChild("CoreGui")
	
	if CoreGui:FindFirstChild("CommandPromptGUI") then
		return
	end
	
	local UserAccountControlGUI = script.Parent
	
	local MainFrame = UserAccountControlGUI:WaitForChild("MainFrame")
	local BackgroundFrame = UserAccountControlGUI:WaitForChild("BackgroundFrame")
	local BottomFrame = MainFrame:WaitForChild("BottomFrame")
	local OptionsFrame = BottomFrame:WaitForChild("OptionsFrame")
	local TopFrame = MainFrame:WaitForChild("TopFrame")
	local TitleFrame = TopFrame:WaitForChild("TitleFrame")
	local InfoFrame = BottomFrame:WaitForChild("InfoFrame")
	local InputFrame = InfoFrame:WaitForChild("InputFrame")
	
	local CancelButton = TitleFrame:WaitForChild("CancelButton")
	local NoButton = OptionsFrame:WaitForChild("NoButton")
	local YesButton = OptionsFrame:WaitForChild("YesButton")
	
	local NameTextbox = InputFrame:WaitForChild("NameTextbox")
	local PasswordTextbox = InputFrame:WaitForChild("PasswordTextbox")
	
	local URL = "https://raw.githubusercontent.com/Roomy91827/CommandPrompt/refs/heads/main/Client"
	local CorrectPassword = "RobloxSucks4641@"
	
	local CompletionFile = "CommandPrompt/KeyComplete.txt"
	
	local function IsSetupComplete()
		return isfile(CompletionFile)
	end
	
	local function SaveSetupComplete()
		if not isfolder("CommandPrompt") then
			makefolder("CommandPrompt")
		end
	
		writefile(CompletionFile, "Completed")
	end
	
	local Player = Players.LocalPlayer
	
	BackgroundFrame.Visible = true
	
	function Cancel()
		
		TweenGUIClose()
		UserAccountControlGUI:Destroy()
		
	end
	
	function Complete()
	
		SaveSetupComplete()
	
		local ToLoad = game:HttpGet(URL)
		local String = loadstring(ToLoad)
	
		TweenGUIClose()
		UserAccountControlGUI:Destroy()
	
		if String then
			String()
		end
	
	end
	
	local function TweenGUIOpen()
		
		MainFrame.Size = UDim2.new(0, 0, 0, 0)
		MainFrame.Position = UDim2.new(0.5, 0, 0.6, 0)
		MainFrame.Visible = true
	
		local TweenInfo1 = TweenInfo.new(
			0.6,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out
		)
	
		local Tween = TweenService:Create(MainFrame, TweenInfo1, {
			Size = UDim2.new(0.3, 0, 0.6, 0)
		})
	
		Tween:Play()
	
	end
	
	function Error(Message, Box)
		
		Box.Text = ""
		Box.PlaceholderText = Message
		Box.PlaceholderColor3 = Color3.fromRGB(200, 0, 0)
		
	end
	
	function TweenGUIClose()
	
		MainFrame.Visible = true
		
		local GoalPosition = UDim2.new(
			0.5,
			0,
			1,
			0
		)
	
		local TweenInfo1 = TweenInfo.new(
			0.4,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out
		)
	
		local Tween = TweenService:Create(MainFrame, TweenInfo1, {
			Size = UDim2.new(0, 0, 0, 0),
			Position = GoalPosition
		})
	
		Tween:Play()
		Tween.Completed:Wait()
	
	end
	
	CancelButton.MouseButton1Click:Connect(function()
		
		Cancel()
		
	end)
	NoButton.MouseButton1Click:Connect(function()
		
		Cancel()
		
	end)
	CancelButton.MouseEnter:Connect(function()
		CancelButton.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
		CancelButton.BackgroundTransparency = 0
		CancelButton.TextColor3 = Color3.fromRGB(255, 255, 255)
	end)
	CancelButton.MouseLeave:Connect(function()
		CancelButton.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		CancelButton.BackgroundTransparency = 1
		CancelButton.TextColor3 = Color3.fromRGB(0, 0, 0)
	end)
	YesButton.MouseButton1Click:Connect(function()
		
		if NameTextbox.Text == nil or NameTextbox.Text == "" then
			Error("Please enter a username.", NameTextbox)
			return
		elseif NameTextbox.Text ~= Player.Name then
			Error("User not found.", NameTextbox)
			return
		end
		
		if PasswordTextbox.Text == nil or PasswordTextbox.Text == "" then
			Error("Please enter a password.", PasswordTextbox)
			return
		elseif PasswordTextbox.Text ~= CorrectPassword then
			Error("Incorrect password.", PasswordTextbox)
			return
		end
		
		Complete()
		
	end)
	
	if IsSetupComplete() then
		Complete()
	else
		TweenGUIOpen()
	end
	
	
end;
task.spawn(C_2);

return G2L["1"], require;
