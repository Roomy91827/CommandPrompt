	local function ServerHop(Player)
	
		local Result = {}
	
		if RunService:IsStudio() then
			Result.Result = "Failed"
			Result.Message = "This command can't be used here."
			return Result
		end
	
		local PlaceID = game.PlaceId
		local AllIDs = {}
		local FoundAnything = ""
		local ActualHour = os.date("!*t").hour
	
		local FileName = "NotSameServers.json"
	
		local FileSuccess, FileData = pcall(function()
			return HttpService:JSONDecode(readfile(FileName))
		end)
	
		if FileSuccess and type(FileData) == "table" then
			AllIDs = FileData
		end
	
		if tonumber(AllIDs[1]) ~= ActualHour then
			AllIDs = {ActualHour}
		end
	
		local function SaveHistory()
	
			pcall(function()
				writefile(
					FileName,
					HttpService:JSONEncode(AllIDs)
				)
			end)
	
		end
	
		local function HasVisited(ID)
	
			for Index = 2, #AllIDs do
				if tostring(AllIDs[Index]) == tostring(ID) then
					return true
				end
			end
	
			return false
		end
	
		for Page = 1, 20 do
	
			local URL = "https://games.roblox.com/v1/games/"
				.. PlaceID
				.. "/servers/Public?sortOrder=Asc&limit=100"
	
			if FoundAnything ~= "" then
				URL ..= "&cursor=" .. HttpService:UrlEncode(FoundAnything)
			end
	
			local Success, Site = pcall(function()
				return HttpService:JSONDecode(game:HttpGet(URL))
			end)
	
			if not Success or type(Site) ~= "table" or type(Site.data) ~= "table" then
				Result.Result = "Failed"
				Result.Message = "Failed to retrieve server list."
				return Result
			end
	
			for _, Server in ipairs(Site.data) do
	
				local ID = tostring(Server.id)
	
				local Available =
					Server.playing < Server.maxPlayers
	
				local NotCurrent =
					ID ~= game.JobId
	
				if Available and NotCurrent and not HasVisited(ID) then
	
					table.insert(AllIDs, ID)
	
					local TeleportSuccess, ErrorMessage = pcall(function()
						
						SaveScript()
	
						TeleportService:TeleportToPlaceInstance(
							PlaceID,
							ID,
							Player
						)
	
					end)
	
					if TeleportSuccess then
						Result.Result = "Success"
						Result.Message = "Joining server: " .. ID
						return Result
					end
	
					table.remove(AllIDs, #AllIDs)
					SaveHistory()
	
					warn("Server hop failed:", ErrorMessage)
	
				end
			end
	
			FoundAnything = Site.nextPageCursor or ""
	
			if FoundAnything == "" then
				break
			end
		end
	
		Result.Result = "Failed"
		Result.Message = "No available unvisited servers found."
	
		return Result
	end
	
