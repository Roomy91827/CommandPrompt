local function View(Player, OtherPlayer, Toggle)

	local Result = {}

	local Data = CommandData.View.Data
	local StoredValues = Data.StoredValues

	if not Toggle then

		if not StoredValues.Connection then
			Result.Result = "Failed"
			Result.Message = "View isn't active."
			return Result
		end

		Data.Disconnect(StoredValues)

		Result.Result = "Success"
		Result.Message = "View disabled."
		return Result
	end
	
	if Player == OtherPlayer then
		Result.Result = "Failed"
		Result.Message = "That would just waste memory son."
		return Result
	end

	if not OtherPlayer then
		Result.Result = "Failed"
		Result.Message = "Target player required."
		return Result
	end

	local OtherCharacter = OtherPlayer.Character
	local OtherHumanoid = OtherCharacter
		and OtherCharacter:FindFirstChildOfClass("Humanoid")

	if not OtherHumanoid then
		Result.Result = "Failed"
		Result.Message = "Target player missing Humanoid."
		return Result
	end

	local FreecamValues =
		CommandData.Freecam.Data.StoredValues

	if FreecamValues.Connection then
		CommandData.Freecam.Data.Disconnect(FreecamValues)
	end

	if StoredValues.Connection then
		Data.Disconnect(StoredValues)
	end

	local ConnectionData = Data.Connect(OtherPlayer)

	StoredValues.Connection = ConnectionData.Connection
	StoredValues.OriginalCameraSubject = ConnectionData.OriginalCameraSubject
	StoredValues.OtherPlayer = OtherPlayer

	SendOutput({
		Type = "Info",
		Text = "Inventory of " .. OtherPlayer.Name .. ":"
	})

	local Backpack = OtherPlayer:FindFirstChildOfClass("Backpack")
	local Items = {}

	if Backpack then
		for _, Item in ipairs(Backpack:GetChildren()) do
			table.insert(Items, Item.Name)
		end
	end

	for _, Item in ipairs(OtherCharacter:GetChildren()) do
		if Item:IsA("Tool") then
			table.insert(Items, Item.Name .. " (Equipped)")
		end
	end

	if #Items == 0 then
		SendOutput({
			Type = "Info",
			Text = "No inventory items found."
		})
	else
		for _, ItemName in ipairs(Items) do
			SendOutput({
				Type = "Info",
				Text = "- " .. ItemName
			})
		end
	end

	SendOutput({
		Type = "Info",
		Text = "Humanoid properties:"
	})

	local Properties = {
		"Health",
		"MaxHealth",
		"WalkSpeed",
		"JumpPower",
		"JumpHeight",
		"HipHeight",
		"DisplayName",
		"RigType",
		"PlatformStand",
		"Sit",
		"AutoRotate",
		"UseJumpPower"
	}

	for _, Property in ipairs(Properties) do
		local Success, Value = pcall(function()
			return OtherHumanoid[Property]
		end)

		if Success then
			SendOutput({
				Type = "Info",
				Text = Property .. " = " .. tostring(Value)
			})
		end
	end

	Result.Result = "Success"
	Result.Message = "Viewing " .. OtherPlayer.Name .. "."

	return Result
end

