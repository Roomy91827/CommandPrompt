local function FindCommand(Parameters)

	local CommandName = string.lower(Parameters.Command)

	for Name, Data in pairs(CommandData) do

		if string.lower(Name) == CommandName then
			return Data, Name
		end

		for _, Alias in ipairs(Data.Alias or {}) do

			if string.lower(Alias) == CommandName then
				return Data, Name
			end

		end
	end

	return nil
end

local function ResolveArgument(Value, ArgType)

	if ArgType == "String" then
		return Value

	elseif ArgType == "Number" then

		local Number = tonumber(Value)

		if not Number then
			return nil, "Expected a number."
		end

		return Number

	elseif ArgType == "Boolean" then

		Value = string.lower(Value)

		if Value == "true" then
			return true

		elseif Value == "false" then
			return false
		end

		return nil, "Expected true or false."

	elseif ArgType == "Player" then

		local SearchValue = string.lower(Value)
		local PlayersList = Players:GetPlayers()

		for _, OtherPlayer in ipairs(PlayersList) do

			if string.lower(OtherPlayer.Name) == SearchValue then
				return OtherPlayer
			end

		end

		local ExactMatches = {}

		for _, OtherPlayer in ipairs(PlayersList) do

			if string.lower(OtherPlayer.DisplayName) == SearchValue then
				table.insert(ExactMatches, OtherPlayer)
			end

		end

		if #ExactMatches == 1 then
			return ExactMatches[1]
		elseif #ExactMatches > 1 then
			return nil, "Multiple players have the display name '" .. Value .. "'."
		end

		local Matches = {}

		for _, OtherPlayer in ipairs(PlayersList) do

			local Username = string.lower(OtherPlayer.Name)
			local DisplayName = string.lower(OtherPlayer.DisplayName)

			local UsernameMatch =
				string.sub(Username, 1, #SearchValue) == SearchValue

			local DisplayNameMatch =
				string.sub(DisplayName, 1, #SearchValue) == SearchValue

			if UsernameMatch or DisplayNameMatch then
				table.insert(Matches, OtherPlayer)
			end

		end

		if #Matches == 1 then
			return Matches[1]
		elseif #Matches > 1 then
			return nil, "Multiple players match '" .. Value .. "'. Be more specific."
		end

		return nil, "Player '" .. Value .. "' not found."
	end

	return nil, "Unknown argument type: " .. tostring(ArgType)
end

local function ParseInput(Text)

	local Parts = string.split(Text, " ")

	local Parameters = {
		Command = Parts[1],
		Args = {},
	}

	for i = 2, #Parts do

		if Parts[i] ~= "" then
			table.insert(Parameters.Args, Parts[i])
		end
	end

	return Parameters
end

local function GetOverrides(CommandName)

	local Overrides = {}

	local Command = CommandData[CommandName]

	if not Command then
		return Overrides
	end

	for _, Name in ipairs(Command.Overrides or {}) do
		table.insert(Overrides, Name)
	end

	for OtherName, OtherCommand in pairs(CommandData) do

		for _, Name in ipairs(OtherCommand.Overrides or {}) do

			if Name == CommandName then
				table.insert(Overrides, OtherName)
				break
			end

		end

	end

	return Overrides
end

function ExecuteCommand(Text)

	Text = string.gsub(Text, "^%s+", "")
	Text = string.gsub(Text, "%s+$", "")

	if Text == "" then
		return
	end

	Logs += 1

	local LogReference = CommandFrame:Clone()
	LogReference.Name = "Log" .. Logs
	LogReference.LayoutOrder = Logs
	LogReference.Visible = true
	LogReference.Parent = FeedScrollingFrame

	local LogTextbox = LogReference:FindFirstChild("InputTextbox")

	if LogTextbox then
		LogTextbox.Text = Text
		LogTextbox.TextEditable = false
		LogTextbox.ClearTextOnFocus = false
	end

	local Parameters = ParseInput(Text)

	local Command, CommandName = FindCommand(Parameters)

	if not Command then
		SendOutput({
			Type = "Error",
			Text = "Unknown command: " .. Parameters.Command
		})

		return
	end

	if #Parameters.Args ~= #Command.Args then
		SendOutput({
			Type = "Error",
			Text = "Expected " .. #Command.Args ..
				" argument(s), got " .. #Parameters.Args .. "."
		})

		for _, ArgInfo in ipairs(Command.Args) do
			SendOutput({
				Type = "Error",
				Text = ArgInfo.Name .. " - Type: " .. ArgInfo.Type
			})
		end

		return
	end

	local ResolvedArgs = {}
	local AssignedArgs = {}

	for _, InputArg in ipairs(Parameters.Args) do
		local ArgName, Value = string.match(InputArg, "^([^=]+)=(.*)$")
		local SelectedIndex

		if ArgName then
			for i, ArgInfo in ipairs(Command.Args) do
				local Name = ArgInfo.Name
				if Name == ArgName then
					SelectedIndex = i
					break
				end
			end

			if not SelectedIndex then
				SendOutput({
					Type = "Error",
					Text = "Unknown argument: " .. ArgName
				})
				return
			end

			if AssignedArgs[SelectedIndex] then
				SendOutput({
					Type = "Error",
					Text = "Duplicate argument: " .. ArgName
				})
				return
			end

		else
			Value = InputArg

			for i = 1, #Command.Args do
				if not AssignedArgs[i] then
					SelectedIndex = i
					break
				end
			end
		end

		if not SelectedIndex then
			SendOutput({
				Type = "Error",
				Text = "Too many arguments."
			})
			return
		end

		local ArgInfo = Command.Args[SelectedIndex]

		local ResolvedValue, ErrorMessage =
			ResolveArgument(Value, ArgInfo.Type)

		if ResolvedValue == nil then
			SendOutput({
				Type = "Error",
				Text = ArgInfo.Name .. ": "
					.. (ErrorMessage or "Invalid argument.")
			})
			return
		end

		ResolvedArgs[SelectedIndex] = ResolvedValue
		AssignedArgs[SelectedIndex] = true
	end

	for i, ArgInfo in ipairs(Command.Args) do
		if not AssignedArgs[i] then
			SendOutput({
				Type = "Error",
				Text = "Missing argument: " .. ArgInfo.Name.." - Type: "..ArgInfo.Type
			})
			return
		end
	end
	
	local ShouldEnable = false

	for i, ArgInfo in ipairs(Command.Args) do
		if ArgInfo.Name == "Toggle" then
			ShouldEnable = ResolvedArgs[i] == true
			break
		end
	end

	if ShouldEnable then

		local Overrides = GetOverrides(CommandName)

		for _, OverrideName in ipairs(Overrides) do

			local OverrideCommand = CommandData[OverrideName]
			local StoredValues = OverrideCommand.Data.StoredValues

			if StoredValues.Connection then

				OverrideCommand.Data.Disconnect(StoredValues)

				table.clear(StoredValues)

				SendOutput({
					Type = "Error",
					Text = OverrideName .. " was disabled because " .. CommandName .. " overrides it."
				})

			end

		end

	end

	local Result = Command.Callback(ResolvedArgs)

	if not Result then
		return
	end

	if Result.Result == "Success" then

		SendOutput({
			Type = "Success",
			Text = Result.Message
		})

	else

		SendOutput({
			Type = "Error",
			Text = Result.Message
		})
	end

	if CommandName ~= "Repeat" then
		LastCommandInfo.Command = Parameters.Command
		LastCommandInfo.ArgValues = {}

		for _, Arg in ipairs(Parameters.Args) do
			table.insert(LastCommandInfo.ArgValues, Arg)
		end
	end
end

