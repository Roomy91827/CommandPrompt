		Description = "Lets you spectate the game from a free-roaming camera.",

		Data = {
			StoredValues = {},

			Connect = function(Camera, Amount, Player)

				local Result = {}

				local Character = Player.Character
				local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

				if not Humanoid then
					return Result
				end

				local OriginalWalkSpeed = Humanoid.WalkSpeed
				local OriginalJumpPower = Humanoid.JumpPower
				local OriginalJumpHeight = Humanoid.JumpHeight
				local OriginalAutoRotate = Humanoid.AutoRotate

				local OriginalCameraType = Camera.CameraType
				local OriginalCameraSubject = Camera.CameraSubject
				local OriginalCFrame = Camera.CFrame

				local OriginalMouseBehavior = UserInputService.MouseBehavior
				local OriginalMouseIconEnabled = UserInputService.MouseIconEnabled

				local Position = Camera.CFrame.Position
				local Look = Camera.CFrame.LookVector

				local Yaw = math.atan2(-Look.X, -Look.Z)
				local Pitch = math.asin(Look.Y)

				local Keys = {}
				local MouseDelta = Vector2.zero
				local GamepadLook = Vector2.zero

				local TouchInput = nil
				local LastTouchPosition = nil

				Humanoid.WalkSpeed = 0
				Humanoid.JumpPower = 0
				Humanoid.JumpHeight = 0
				Humanoid.AutoRotate = false

				Camera.CameraType = Enum.CameraType.Scriptable

				if UserInputService.KeyboardEnabled then
					UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
					UserInputService.MouseIconEnabled = false
				end

				local InputBegan = UserInputService.InputBegan:Connect(function(Input, Processed)

					if Processed then
						return
					end

					if Input.UserInputType == Enum.UserInputType.Keyboard then
						Keys[Input.KeyCode] = true
					end

					if Input.UserInputType == Enum.UserInputType.Touch then

						local Viewport = Camera.ViewportSize

						if Input.Position.X > Viewport.X / 2 then
							TouchInput = Input
							LastTouchPosition = Input.Position
						end
					end
				end)

				local InputEnded = UserInputService.InputEnded:Connect(function(Input)

					if Input.UserInputType == Enum.UserInputType.Keyboard then
						Keys[Input.KeyCode] = nil
					end

					if Input == TouchInput then
						TouchInput = nil
						LastTouchPosition = nil
					end
				end)

				local InputChanged = UserInputService.InputChanged:Connect(function(Input)

					if Input.UserInputType == Enum.UserInputType.MouseMovement then
						MouseDelta = Input.Delta

					elseif Input.UserInputType == Enum.UserInputType.Touch
						and Input == TouchInput then

						if LastTouchPosition then
							local Delta = Input.Position - LastTouchPosition

							MouseDelta += Vector2.new(Delta.X, Delta.Y)
						end

						LastTouchPosition = Input.Position

					elseif Input.UserInputType == Enum.UserInputType.Gamepad1
						and Input.KeyCode == Enum.KeyCode.Thumbstick2 then

						GamepadLook = Vector2.new(
							Input.Position.X,
							Input.Position.Y
						)
					end
				end)

				local Connection = RunService.RenderStepped:Connect(function(DeltaTime)

					Camera = workspace.CurrentCamera

					if not Camera then
						return
					end

					Yaw -= MouseDelta.X * 0.0025
					Pitch -= MouseDelta.Y * 0.0025

					MouseDelta = Vector2.zero

					local Stick = Vector2.zero

					for _, Input in ipairs(UserInputService:GetGamepadState(Enum.UserInputType.Gamepad1)) do
						if Input.KeyCode == Enum.KeyCode.Thumbstick2 then
							Stick = Vector2.new(Input.Position.X, Input.Position.Y)
							break
						end
					end

					if Stick.Magnitude < 0.15 then
						Stick = Vector2.zero
					end

					local GamepadSensitivity = 2.5

					Yaw -= Stick.X * GamepadSensitivity * DeltaTime
					Pitch += Stick.Y * GamepadSensitivity * DeltaTime

					Pitch = math.clamp(
						Pitch,
						math.rad(-89),
						math.rad(89)
					)

					local Rotation = CFrame.fromOrientation(Pitch, Yaw, 0)

					local MoveDirection = Humanoid.MoveDirection

					local LookVector = Camera.CFrame.LookVector
					local RightVector = Camera.CFrame.RightVector

					local FlatLook = Vector3.new(LookVector.X, 0, LookVector.Z)
					local FlatRight = Vector3.new(RightVector.X, 0, RightVector.Z)

					local Move = Vector3.zero

					if FlatLook.Magnitude > 0 then
						Move += LookVector * MoveDirection:Dot(FlatLook.Unit)
					end

					if FlatRight.Magnitude > 0 then
						Move += RightVector * MoveDirection:Dot(FlatRight.Unit)
					end

					if Move.Magnitude > 0 then
						Move = Move.Unit
					end

					local Speed = Amount

					Position += Move * Speed * DeltaTime

					Camera.CameraType = Enum.CameraType.Scriptable
					Camera.CFrame = CFrame.new(Position) * Rotation
				end)

				Result.Connection = Connection
				Result.InputBegan = InputBegan
				Result.InputEnded = InputEnded
				Result.InputChanged = InputChanged

				Result.Humanoid = Humanoid
				Result.OriginalWalkSpeed = OriginalWalkSpeed
				Result.OriginalJumpPower = OriginalJumpPower
				Result.OriginalJumpHeight = OriginalJumpHeight
				Result.OriginalAutoRotate = OriginalAutoRotate

				Result.OriginalCameraType = OriginalCameraType
				Result.OriginalCameraSubject = OriginalCameraSubject
				Result.OriginalCFrame = OriginalCFrame

				Result.OriginalMouseBehavior = OriginalMouseBehavior
				Result.OriginalMouseIconEnabled = OriginalMouseIconEnabled

				return Result
			end,

			Disconnect = function(StoredValues)

				if StoredValues.Connection then
					StoredValues.Connection:Disconnect()
				end

				if StoredValues.InputBegan then
					StoredValues.InputBegan:Disconnect()
				end

				if StoredValues.InputEnded then
					StoredValues.InputEnded:Disconnect()
				end

				if StoredValues.InputChanged then
					StoredValues.InputChanged:Disconnect()
				end

				local Humanoid = StoredValues.Humanoid

				if Humanoid and Humanoid.Parent then
					Humanoid.WalkSpeed = StoredValues.OriginalWalkSpeed
					Humanoid.JumpPower = StoredValues.OriginalJumpPower
					Humanoid.JumpHeight = StoredValues.OriginalJumpHeight
					Humanoid.AutoRotate = StoredValues.OriginalAutoRotate
				end

				local Camera = workspace.CurrentCamera

				if Camera then
					Camera.CameraType =
						StoredValues.OriginalCameraType or Enum.CameraType.Custom

					Camera.CameraSubject = StoredValues.OriginalCameraSubject
					Camera.CFrame = StoredValues.OriginalCFrame
				end

				UserInputService.MouseBehavior =
					StoredValues.OriginalMouseBehavior or Enum.MouseBehavior.Default

				UserInputService.MouseIconEnabled =
					StoredValues.OriginalMouseIconEnabled ~= false

				table.clear(StoredValues)
			end,

		},

