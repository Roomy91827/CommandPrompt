						StoredValues.OriginalMouseBehavior
						or Enum.MouseBehavior.Default
	
					UserInputService.MouseIconEnabled =
						StoredValues.OriginalMouseIconEnabled ~= false
	
					table.clear(StoredValues)
				end,
