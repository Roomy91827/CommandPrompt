		local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
	
		local Data = CommandData.SetHipheight.Data
		local StoredValues = Data.StoredValues
	
		if not Toggle then
	
			if not StoredValues.Connection then
				Result.Result = "Failed"
				Result.Message = "SetHipheight isn't active."
				return Result
			end
	
			Data.Disconnect(StoredValues)
	
			Result.Result = "Success"
			Result.Message = "SetHipheight disabled."
			return Result
		end
	
		if not Character then
			Result.Result = "Failed"
			Result.Message = "Local player has no Character."
			return Result
		end
	
		if not Humanoid then
			Result.Result = "Failed"
			Result.Message = "Local player missing Humanoid."
			return Result
		end
	
		if StoredValues.Connection then
			Data.Disconnect(StoredValues)
		end
	
		local ConnectionData = Data.Connect(Humanoid, Value)
	
		StoredValues.Connection = ConnectionData.Connection
		StoredValues.OriginalHipHeight = ConnectionData.OriginalHipHeight
		StoredValues.Humanoid = Humanoid
	
		Result.Result = "Success"
		Result.Message = "HipHeight set to " .. Value .. "."
	
