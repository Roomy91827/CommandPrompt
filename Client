	local function ExecuteCommand(Text)
	
		Text = string.gsub(Text, "^%s+", "")
		Text = string.gsub(Text, "%s+$", "")
	
		if Text == "" then
			return
		end
	
		Logs += 1
	
		local LogReference = CommandFrame:Clone()
		LogReference.Name = "Log" .. Logs
		LogReference.LayoutOrder = Logs
		LogReference.Visible = true
		LogReference.Parent = FeedScrollingFrame
	
		local LogTextbox = LogReference:FindFirstChild("InputTextbox")
	
		if LogTextbox then
			LogTextbox.Text = Text
			LogTextbox.TextEditable = false
			LogTextbox.ClearTextOnFocus = false
		end
	
		local Parameters = ParseInput(Text)
	
		local Command, CommandName = FindCommand(Parameters)
	
		if not Command then
			SendOutput({
				Type = "Error",
				Text = "Unknown command: " .. Parameters.Command
			})
	
			return
		end
	
		if #Parameters.Args ~= #Command.Args then
			SendOutput({
				Type = "Error",
				Text = "Expected " .. #Command.Args ..
					" argument(s), got " .. #Parameters.Args .. "."
			})
	
			for _, ArgInfo in ipairs(Command.Args) do
				SendOutput({
					Type = "Error",
					Text = ArgInfo.Name .. " - Type: " .. ArgInfo.Type
				})
			end
	
			return
		end
	
		local ResolvedArgs = {}
		local AssignedArgs = {}
	
		for _, InputArg in ipairs(Parameters.Args) do
			local ArgName, Value = string.match(InputArg, "^([^=]+)=(.*)$")
			local SelectedIndex
	
			if ArgName then
				for i, ArgInfo in ipairs(Command.Args) do
					local Name = ArgInfo.Name
					if Name == ArgName then
						SelectedIndex = i
						break
					end
				end
	
				if not SelectedIndex then
					SendOutput({
						Type = "Error",
						Text = "Unknown argument: " .. ArgName
					})
					return
				end
	
				if AssignedArgs[SelectedIndex] then
					SendOutput({
						Type = "Error",
						Text = "Duplicate argument: " .. ArgName
					})
					return
				end
	
			else
				Value = InputArg
	
				for i = 1, #Command.Args do
					if not AssignedArgs[i] then
						SelectedIndex = i
						break
					end
				end
			end
	
			if not SelectedIndex then
				SendOutput({
					Type = "Error",
					Text = "Too many arguments."
				})
				return
			end
	
			local ArgInfo = Command.Args[SelectedIndex]
	
			local ResolvedValue, ErrorMessage =
				ResolveArgument(Value, ArgInfo.Type)
	
			if ResolvedValue == nil then
				SendOutput({
					Type = "Error",
					Text = ArgInfo.Name .. ": "
						.. (ErrorMessage or "Invalid argument.")
				})
				return
			end
	
			ResolvedArgs[SelectedIndex] = ResolvedValue
			AssignedArgs[SelectedIndex] = true
		end
	
		for i, ArgInfo in ipairs(Command.Args) do
			if not AssignedArgs[i] then
				SendOutput({
					Type = "Error",
					Text = "Missing argument: " .. ArgInfo.Name.." - Type: "..ArgInfo.Type
				})
				return
			end
		end
	
		local Result = Command.Callback(ResolvedArgs)
	
		if not Result then
			return
		end
	
		if Result.Result == "Success" then
	
			SendOutput({
				Type = "Success",
				Text = Result.Message
			})
	
		else
	
			SendOutput({
				Type = "Error",
				Text = Result.Message
			})
		end
	end
	
