local function Orbit(Player, Target, Speed, Distance, Toggle)

	local Result = {}

	local Data = CommandData.Orbit.Data
	local StoredValues = Data.StoredValues

	if not Toggle then

		if not StoredValues.Connection then
			Result.Result = "Failed"
			Result.Message = "Orbit isn't active."
			return Result
		end

		Data.Disconnect(StoredValues)

		Result.Result = "Success"
		Result.Message = "Orbit disabled."

		return Result
	end
	
	if Player == Target then
		Result.Result = "Failed"
		Result.Message = "That would just be silly."
		return Result
	end

	local Character = Player.Character

	if not Character then
		Result.Result = "Failed"
		Result.Message = "Local player has no Character."
		return Result
	end
	
	local HumanoidRootPart = Character:FindFirstChild("HumanoidRootPart")
	if not HumanoidRootPart then
		Result.Result = "Failed"
		Result.Message = "Local player has no HumanoidRootPart."
		return Result
	end
	
	local Humanoid = Character:FindFirstChild("Humanoid")
	if not Humanoid then
		Result.Result = "Failed"
		Result.Message = "Local player has no Humanoid."
		return Result
	end

	local TargetCharacter = Target.Character

	if not TargetCharacter then
		Result.Result = "Failed"
		Result.Message = "Target character not found."
		return Result
	end

	local TargetHumanoidRootPart = TargetCharacter:FindFirstChild("HumanoidRootPart")

	if not TargetHumanoidRootPart then
		Result.Result = "Failed"
		Result.Message = "Target player has no HumanoidRootPart."
		return Result
	end

	if StoredValues.Connection then
		Data.Disconnect(StoredValues)
	end

	local ConnectionData = Data.Connect(Distance, Target, HumanoidRootPart, Speed)

	StoredValues.Connection = ConnectionData.Connection
	StoredValues.HumanoidRootPart = HumanoidRootPart
	StoredValues.Humanoid = Humanoid
	StoredValues.Target = Target
	StoredValues.Speed = Speed
	StoredValues.WasAnchored = ConnectionData.WasAnchored
	StoredValues.WasAutoRotate = ConnectionData.WasAutoRotate
	StoredValues.Distance = Distance

	Result.Result = "Success"
	Result.Message = "Orbit enabled."

	return Result
end

local function GetPlayerList()

	local Result = {}
	local PlayerList = {}

	for _, Player in ipairs(Players:GetPlayers()) do
		local Info = {}
		Info.Name = Player.Name
		Info.DisplayName = Player.DisplayName
		table.insert(PlayerList, Info)
	end

	for _, InfoTable in PlayerList do
