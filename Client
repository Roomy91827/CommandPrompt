							if workspace.CurrentCamera ~= Camera then
								Camera = workspace.CurrentCamera
							end
	
							if not Camera then return end
	
							Yaw -= MouseDelta.X * 0.0025
							Pitch -= MouseDelta.Y * 0.0025
	
							Pitch = math.clamp(
								Pitch,
								math.rad(-89),
								math.rad(89)
							)
	
							MouseDelta = Vector2.zero
	
							local Rotation =
							CFrame.fromOrientation(Pitch, Yaw, 0)
	
							local Move = Vector3.zero
	
							if Keys[Enum.KeyCode.W] then
								Move += Vector3.new(0, 0, -1)
							end
	
							if Keys[Enum.KeyCode.S] then
								Move += Vector3.new(0, 0, 1)
							end
	
							if Keys[Enum.KeyCode.A] then
								Move += Vector3.new(-1, 0, 0)
							end
	
							if Keys[Enum.KeyCode.D] then
								Move += Vector3.new(1, 0, 0)
							end
	
							if Keys[Enum.KeyCode.Space] then
								Move += Vector3.new(0, 1, 0)
							end
	
							if Keys[Enum.KeyCode.LeftControl] then
								Move -= Vector3.new(0, 1, 0)
							end
	
							local Speed = Amount
	
							if Keys[Enum.KeyCode.LeftShift] then
								Speed *= 3
							end
	
							if Move.Magnitude > 0 then
								Move = Move.Unit
							end
	
							Position += Rotation:VectorToWorldSpace(Move)
							* Speed * DeltaTime
	
							Camera.CameraType = Enum.CameraType.Scriptable
							Camera.CFrame = CFrame.new(Position) * Rotation
						end)
	
					Result.Connection = Connection
					Result.InputBegan = InputBegan
					Result.InputEnded = InputEnded
					Result.InputChanged = InputChanged
	
					Result.OriginalCameraType = OriginalCameraType
					Result.OriginalCameraSubject = OriginalCameraSubject
					Result.OriginalCFrame = OriginalCFrame
	
					Result.OriginalMouseBehavior = OriginalMouseBehavior
					Result.OriginalMouseIconEnabled = OriginalMouseIconEnabled
	
					return Result
				end,
	
				Disconnect = function(StoredValues)
	
					if StoredValues.Connection then
						StoredValues.Connection:Disconnect()
					end
	
					if StoredValues.InputBegan then
						StoredValues.InputBegan:Disconnect()
					end
	
					if StoredValues.InputEnded then
						StoredValues.InputEnded:Disconnect()
					end
	
					if StoredValues.InputChanged then
						StoredValues.InputChanged:Disconnect()
					end
	
					local Camera = workspace.CurrentCamera
	
