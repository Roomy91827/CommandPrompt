local function CheckDuplication(Parent, CVersion)
	
	for _, InstanceA in ipairs(Parent:GetChildren()) do
		if InstanceA.Name == "CommandPromptGUI"
			and InstanceA ~= CommandPromptGUI then

			local VersionAttribute = InstanceA:GetAttribute("Version")

			if typeof(VersionAttribute) == "number"
				and VersionAttribute >= CVersion then
				
				CommandPromptGUI:Destroy()

				warn("New version "..VersionAttribute.." of CommandPrompt is already running.")

				return true
			else
				InstanceA:Destroy()
				
				warn("Old version "..tostring(VersionAttribute).." of CommandPrompt was removed.")
			end
		end
	end

	return false
end

local function GetExecutionType()
	if RunService:IsStudio() then
		return "Studio"
	end

	if type(identifyexecutor) == "function"
		or type(getgenv) == "function"
		or type(writefile) == "function"
		or type(readfile) == "function" then
		return "Executor"
	end

	return "LocalScript"
end

function SendOutput(MessageData)

	local MessageType = MessageData.Type or "Info"
	local MessageText = tostring(MessageData.Text or "")

	Logs += 1

	local NewMessageFrame = MessageTemplate:Clone()
	NewMessageFrame.Name = "Message" .. Logs
	NewMessageFrame.LayoutOrder = Logs
	NewMessageFrame.Visible = true
	NewMessageFrame.Parent = FeedScrollingFrame

	NewMessageFrame.Text = MessageText

	if MessageType == "Error" then
		NewMessageFrame.TextColor3 = Color3.fromRGB(200, 65, 65)

	elseif MessageType == "Success" then
		NewMessageFrame.TextColor3 = Color3.fromRGB(100, 200, 100)

	else
		NewMessageFrame.TextColor3 = Color3.fromRGB(220, 220, 220)
	end

	FeedScrollingFrame.CanvasPosition = Vector2.new(
		0,
		FeedScrollingFrame.AbsoluteCanvasSize.Y
	)

	CommandFrame.LayoutOrder = Logs + 1
	
	local BDelay = math.random(1, 10) / 100

	task.wait(BDelay)
	
end

