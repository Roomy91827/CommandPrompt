local function ServerHop(Player)

	local Result = {}

	if ExecutionType == "Studio" then
		Result.Result = "Failed"
		Result.Message = "This command can't be used in Studio goofball."
		return Result
	end

	local PlaceID = game.PlaceId
	local AllIDs = {}
	local FoundAnything = ""
	local ActualHour = os.date("!*t").hour

	local FileName = "NotSameServers.json"

	if ExecutionType == "Executor" then
		local FileSuccess, FileData = pcall(function()
			return HttpService:JSONDecode(readfile(FileName))
		end)

		if FileSuccess and type(FileData) == "table" then
			AllIDs = FileData
		end
	end

	if tonumber(AllIDs[1]) ~= ActualHour then
		AllIDs = {ActualHour}
	end

	local function SaveHistory()
		if ExecutionType ~= "Executor" then
			return
		end

		pcall(function()
			writefile(FileName, HttpService:JSONEncode(AllIDs))
		end)
	end

	local function HasVisited(ID)
		for Index = 2, #AllIDs do
			if tostring(AllIDs[Index]) == tostring(ID) then
				return true
			end
		end

		return false
	end

	for Page = 1, 20 do

		local URL = "https://games.roblox.com/v1/games/"
			.. PlaceID
			.. "/servers/Public?sortOrder=Asc&limit=100"

		if FoundAnything ~= "" then
			URL ..= "&cursor=" .. HttpService:UrlEncode(FoundAnything)
		end

		local Success, Site = pcall(function()

			local Response

			if ExecutionType == "Executor" then
				Response = game:HttpGet(URL)
			else
				Response = HttpService:GetAsync(URL)
			end

			return HttpService:JSONDecode(Response)

		end)

		if not Success or type(Site) ~= "table"
			or type(Site.data) ~= "table" then

			Result.Result = "Failed"
			Result.Message = "Failed to retrieve server list."
			return Result
		end

		for _, Server in ipairs(Site.data) do

			local ID = tostring(Server.id)

			local Available = Server.playing < Server.maxPlayers
			local NotCurrent = ID ~= game.JobId

			if Available and NotCurrent and not HasVisited(ID) then

				table.insert(AllIDs, ID)

				local TeleportSuccess, ErrorMessage = pcall(function()
					TeleportService:TeleportToPlaceInstance(
						PlaceID,
						ID,
						Player
					)
				end)

				if TeleportSuccess then
					Result.Result = "Success"
					Result.Message = "Joining server: " .. ID
					return Result
				end

				table.remove(AllIDs, #AllIDs)
				SaveHistory()

				warn("Server hop failed:", ErrorMessage)
			end
		end

		FoundAnything = Site.nextPageCursor or ""

		if FoundAnything == "" then
			break
		end
	end

	Result.Result = "Failed"
	Result.Message = "No available unvisited servers found."

	return Result
end


local function FormatList(List)
	local Output = {}

	for _, Value in ipairs(List or {}) do
		if typeof(Value) == "table" then
			Value = Value.Name or Value.Type or Value.Description or "Unknown"
		end

		table.insert(Output, tostring(Value))
	end

	return #Output > 0 and table.concat(Output, ", ") or "None"
end

function GetCommandInfo(CommandAlias)
	
	local CommandInfo
	local Command = nil

	for Name, Data in pairs(CommandData) do
		if Name:lower() == CommandAlias:lower() then
			CommandInfo = Data
			Command = Name
			break
		end

		for _, Alias in ipairs(Data.Alias or {}) do
			if Alias:lower() == CommandAlias:lower() then
				CommandInfo = Data
				Command = Name
				break
			end
		end

		if CommandInfo then
			break
		end
	end

	local Result = {}

	if not CommandInfo then
		Result.Result = "Failed"
		Result.Message = "Invalid command."
		return Result
	end

	local Info = {
		"Command: " .. tostring(Command),
		"Args: " .. FormatList(CommandInfo.Args),
		"Aliases: " .. FormatList(CommandInfo.Alias),
		"CleanupOnDeath: " .. tostring(CommandInfo.CleanupOnDeath),
		"Description: " .. tostring(CommandInfo.Description),
	}

	Result.Result = "Success"
	Result.Message = "Displayed command information."
	
	SendOutput({
		Text = "Command Information:",
	})
	
	for _, Info in ipairs(Info) do
		SendOutput({
			Text = Info,
		})
	end

	return Result
end


local function GetPublicData(URL)

	local Success, Response = pcall(function()

		if ExecutionType == "Executor" then
			return game:HttpGet(URL)
		else
			error("HTTP requests require a server-side handler.")
		end

	end)

	if not Success then
		SendOutput({
			Type = "Error",
			Text = "HTTP Request Failed:\n"
				.. URL .. "\n"
				.. tostring(Response),
		})

		return nil
	end

	local DecodeSuccess, Data = pcall(function()
		return HttpService:JSONDecode(Response)
	end)

	if not DecodeSuccess then
		SendOutput({
			Type = "Error",
			Text = "JSON Decode Failed:\n"
				.. URL .. "\n"
				.. tostring(Data),
		})

		return nil
	end

	if type(Data) ~= "table" then
		SendOutput({
			Type = "Error",
			Text = "Invalid API Response:\n" .. URL,
		})

		return nil
	end

	if Data.errors then
		SendOutput({
			Type = "Error",
			Text = "API Error:\n"
				.. URL .. "\n"
				.. tostring(Data.errors),
		})

		return nil
	end

	return Data
end


local function GetPlayerInfo(Username)

	local Result = {}

	local Success, UserId = pcall(function()
		return Players:GetUserIdFromNameAsync(Username)
	end)

	if not Success then
		Result.Result = "Failed"
		Result.Message = "Invalid name."
		return Result
	end

	local PlayerObject = Players:GetPlayerByUserId(UserId)

	local InfoSuccess, UserInfos = pcall(function()
		return UserService:GetUserInfosByUserIdsAsync({UserId})
	end)

	if not InfoSuccess or not UserInfos[1] then
		Result.Result = "Failed"
		Result.Message = "Unable to retrieve user information."
		return Result
	end

	local User = UserInfos[1]

	local Profile = GetPublicData(
		"https://users.roblox.com/v1/users/" .. UserId
	)

	local Friends = GetPublicData(
		"https://friends.roblox.com/v1/users/" .. UserId .. "/friends/count"
	)

	local Followers = GetPublicData(
		"https://friends.roblox.com/v1/users/" .. UserId .. "/followers/count"
	)

	local Following = GetPublicData(
		"https://friends.roblox.com/v1/users/" .. UserId .. "/followings/count"
	)

	local Headshot = GetPublicData(
		"https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds="
			.. UserId .. "&size=150x150&format=Png&isCircular=false"
	)

	local UsernameHistory = GetPublicData(
		"https://users.roblox.com/v1/users/" .. UserId
			.. "/username-history?limit=100&sortOrder=Asc"
	)

	local AccountAge = "Unavailable"
	local AccountCreated = "Unavailable"

	if Profile and Profile.created then
		local Date = DateTime.fromIsoDate(Profile.created)

		if Date then
			AccountCreated = Date:FormatLocalTime(
				"YYYY, MMMM D, h:mm A",
				"en-us"
			)

			AccountAge = math.floor(
				(DateTime.now().UnixTimestamp - Date.UnixTimestamp) / 86400
			) .. " Days"
		end
	end

	local PreviousUsernames = {}

	if UsernameHistory and UsernameHistory.data then
		for _, Entry in ipairs(UsernameHistory.data) do
			table.insert(PreviousUsernames, Entry.name)
		end
	end

	local HeadshotURL = "Unavailable"

	if Headshot and Headshot.data and Headshot.data[1] then
		HeadshotURL = Headshot.data[1].imageUrl
	end

	local IsBanned = "Unavailable"

	if Profile and Profile.isBanned ~= nil then
		IsBanned = Profile.isBanned and "Yes" or "No"
	end

	local Verified = "Unavailable"
	if User.HasVerifiedBadge == true then
		Verified = "Yes"
	elseif User.HasVerifiedBadge == false then
		Verified = "No"
	end

	local Description = "Unavailable"
	if Profile and Profile.description then
		if Profile.description == "" then
			Description = "(No description)"
		else
			Description = Profile.description
		end
	end
	
	local MembershipType = "Unavailable"
	local HasPremium = false
	local HasPlus = false

	if PlayerObject then

		HasPremium = PlayerObject.MembershipType == Enum.MembershipType.Premium
		HasPlus = PlayerObject.HasRobloxSubscription

		local DisplayedMembership = {}

		if HasPlus then
			table.insert(DisplayedMembership, "Roblox Plus")
		end

		if HasPremium then
			table.insert(DisplayedMembership, "Premium")
		end

		if #DisplayedMembership > 0 then
			MembershipType = table.concat(DisplayedMembership, " and ")
		else
			MembershipType = "Free"
		end
	end

	local Info = {

		Username = User.Username,
		DisplayName = User.DisplayName,
		UserId = User.Id,

		Verified = Verified,

		AccountCreated = AccountCreated,
		AccountAge = AccountAge,
		IsBanned = IsBanned,
		Description = Description,

		MembershipType = MembershipType,

		FriendsCount = Friends and Friends.count or "Unavailable",
		FollowersCount = Followers and Followers.count or "Unavailable",
		FollowingCount = Following and Following.count or "Unavailable",

		PreviousUsernames = FormatList(PreviousUsernames),

		HeadshotURL = HeadshotURL,

		ProfileURL = "https://www.roblox.com/users/"
			.. User.Id .. "/profile",
	}

	local InfoOrder = {
		"Username",
		"DisplayName",
		"UserId",
		"Verified",
		"AccountCreated",
		"AccountAge",
		"IsBanned",
		"Description",
		"MembershipType",
		"FriendsCount",
		"FollowersCount",
		"FollowingCount",
		"PreviousUsernames",
		"HeadshotURL",
		"ProfileURL",
	}

	SendOutput({
		Text = "Player Information:",
	})

	for _, Key in ipairs(InfoOrder) do
		SendOutput({
			Text = Key .. ": " .. tostring(Info[Key]),
		})
	end

	Result.Result = "Success"
	Result.Message = "Displayed player information."

	return Result
end

local function RepeatCommand()

	local Result = {}

	if not LastCommandInfo.Command then
		Result.Result = "Failed"
		Result.Message = "There is no previous command."
		return Result
	end

	if LastCommandInfo.Command == "RepeatCommand" then
		Result.Result = "Failed"
		Result.Message = "You can't repeat THE repeat command silly."
		return Result
	end

	local Text = LastCommandInfo.Command

	for _, Arg in ipairs(LastCommandInfo.ArgValues) do
		Text ..= " " .. tostring(Arg)
	end

	Result.Result = "Success"
	Result.Message = "Repeating command..."

	task.defer(ExecuteCommand, Text)

	return Result
end

