	function LoadScript(Script)
	
		local Result = {}
	
		if RunService:IsStudio() then
			Result.Result = "Failed"
			Result.Message = "Loadstring doesn't work here."
			return Result
		end
	
		local Success, ErrorMessage = pcall(function()
			local Source = game:HttpGet(Script)
			local Function, CompileError = loadstring(Source)
	
			if not Function then
				error(CompileError)
			end
	
			Function()
		end)
	
		if not Success then
			Result.Result = "Failed"
			Result.Message = "Failed to loadstring: " .. tostring(ErrorMessage)
			return Result
		end
	
		Result.Result = "Success"
		Result.Message = "Successfully loaded script."
	
		return Result
	end
	local function FindCommand(Parameters)
	
		local CommandName = string.lower(Parameters.Command)
	
		for Name, Data in pairs(CommandData) do
	
			if string.lower(Name) == CommandName then
				return Data, Name
			end
	
			for _, Alias in ipairs(Data.Alias or {}) do
	
				if string.lower(Alias) == CommandName then
					return Data, Name
				end
	
			end
		end
	
		return nil
	end
	
	function Fly(Player, Amount, Toggle)
	
		local Result = {}
	
		local Character = Player.Character
		
		if not Character then
			Result.Result = "Failed"
			Result.Message = "Local player has no character."
			return Result
		end
		local Humanoid = Character:FindFirstChildOfClass("Humanoid")
		
		if not Humanoid then
			Result.Result = "Failed"
			Result.Message = "Local player missing humanoid."
			return Result
		end
		local HumanoidRootPart = Character:FindFirstChild("HumanoidRootPart")
		
		if not HumanoidRootPart then
			Result.Result = "Failed"
			Result.Message = "Local player missing HumanoidRootPart."
			return Result
		end
		
		HumanoidRootPart.Anchored = true
	
		local Data = CommandData.Fly.Data
		local StoredValues = Data.StoredValues
	
		if not Toggle then
	
			if not StoredValues.Connection then
				Result.Result = "Failed"
				Result.Message = "Fly isn't active."
				return Result
			end
	
			Data.Disconnect(StoredValues)
	
			Result.Result = "Success"
			Result.Message = "Fly disabled."
			return Result
		end
	
		if StoredValues.Connection then
			Data.Disconnect(StoredValues)
		end
	
		local ConnectionData = Data.Connect(
			Character,
			Humanoid,
			HumanoidRootPart,
			Amount
		)
	
		StoredValues.Connection = ConnectionData.Connection
		StoredValues.Humanoid = Humanoid
		StoredValues.HumanoidRootPart = HumanoidRootPart
		StoredValues.OriginalAutoRotate = ConnectionData.OriginalAutoRotate
		StoredValues.OriginalPlatformStand = ConnectionData.OriginalPlatformStand
	
		Result.Result = "Success"
		Result.Message = "Fly enabled at speed " .. Amount .. "."
	
		return Result
	end
	
	function PartWalk(Player, Toggle, Floored)
	
		local Result = {}
	
		local Character = Player.Character
		local HumanoidRootPart = Character and Character:FindFirstChild("HumanoidRootPart")
	
		local Data = CommandData.PartWalk.Data
		local StoredValues = Data.StoredValues
	
		if not Toggle then
	
			if not StoredValues.Connection then
				Result.Result = "Failed"
				Result.Message = "PartWalk isn't active."
				return Result
			end
	
			Data.Disconnect(StoredValues)
	
			Result.Result = "Success"
			Result.Message = "PartWalk disabled."
			return Result
		end
	
		if not Character or not HumanoidRootPart then
			Result.Result = "Failed"
			Result.Message = "Local player missing HumanoidRootPart."
			return Result
		end
	
		if StoredValues.Connection then
			Data.Disconnect(StoredValues)
		end
	
		local ConnectionData = Data.Connect(HumanoidRootPart, Floored)
	
		StoredValues.Connection = ConnectionData.Connection
		StoredValues.Part = ConnectionData.Part
		StoredValues.HumanoidRootPart = HumanoidRootPart
	
		Result.Result = "Success"
		Result.Message = "PartWalk enabled."
	
		return Result
	end
	
	function SendOutput(MessageData)
	
		local MessageType = MessageData.Type or "Info"
		local MessageText = tostring(MessageData.Text or "")
	
		Logs += 1
	
		local NewMessageFrame = MessageTemplate:Clone()
		NewMessageFrame.Name = "Message" .. Logs
		NewMessageFrame.LayoutOrder = Logs
		NewMessageFrame.Visible = true
		NewMessageFrame.Parent = FeedScrollingFrame
	
		local MessageLabel = NewMessageFrame:FindFirstChild("MessageLabel")
	
		if MessageLabel then
	
			MessageLabel.Text = MessageText
	
			if MessageType == "Error" then
				MessageLabel.TextColor3 = Color3.fromRGB(200, 65, 65)
	
			elseif MessageType == "Success" then
				MessageLabel.TextColor3 = Color3.fromRGB(100, 200, 100)
	
			else
				MessageLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
			end
		end
	
		FeedScrollingFrame.CanvasPosition = Vector2.new(
			0,
			FeedScrollingFrame.AbsoluteCanvasSize.Y
		)
	
		CommandFrame.LayoutOrder = Logs + 1
	end
	
	local function ResolveArgument(Value, ArgType)
	
		if ArgType == "String" then
			return Value
	
		elseif ArgType == "Number" then
	
			local Number = tonumber(Value)
	
			if not Number then
				return nil, "Expected a number."
			end
	
			return Number
	
		elseif ArgType == "Boolean" then
	
			Value = string.lower(Value)
	
			if Value == "true" then
				return true
	
			elseif Value == "false" then
				return false
			end
	
			return nil, "Expected true or false."
	
		elseif ArgType == "Player" then
	
			local SearchValue = string.lower(Value)
	
			for _, OtherPlayer in ipairs(Players:GetPlayers()) do
	
				if string.lower(OtherPlayer.Name) == SearchValue then
					return OtherPlayer
				end
			end
	
			for _, OtherPlayer in ipairs(Players:GetPlayers()) do
	
				if string.sub(
					string.lower(OtherPlayer.Name),
					1,
					#SearchValue
					) == SearchValue then
	
					return OtherPlayer
				end
			end
	
			return nil, "Player '" .. Value .. "' not found."
		end
	
		return nil, "Unknown argument type: " .. tostring(ArgType)
	end
	
	local function ParseInput(Text)
	
		local Parts = string.split(Text, " ")
	
		local Parameters = {
			Command = Parts[1],
			Args = {},
		}
	
		for i = 2, #Parts do
	
			if Parts[i] ~= "" then
				table.insert(Parameters.Args, Parts[i])
			end
		end
	
		return Parameters
	end
	
