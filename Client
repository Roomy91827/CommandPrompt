			Connect = function(HumanoidRootPart, Floored)

				local Result = {}

				local Part = workspace:FindFirstChild("WalkPart")

				if not Part then
					Part = Instance.new("Part")
					Part.Name = "WalkPart"
					Part.Size = Vector3.new(4, 1, 4)
					Part.Anchored = true
					Part.Transparency = 1
					Part.CanCollide = true
					Part.Parent = workspace
				end

				local FixedY = HumanoidRootPart.Position.Y
				- HumanoidRootPart.Size.Y / 2
				- 2.5

				local Connection = RunService.Heartbeat:Connect(function()

					if not HumanoidRootPart.Parent then
						return
					end

					local Position = HumanoidRootPart.Position

					if Position.Y < -500 then
						return
					end

					local PlatformY

					if Floored then
						PlatformY = FixedY
					else
						PlatformY = Position.Y
						- HumanoidRootPart.Size.Y / 2
						- 2.5
					end

					Part.CFrame = CFrame.new(
						Position.X,
						PlatformY,
						Position.Z
					)

				end)

				Result.Connection = Connection
				Result.Part = Part

				return Result
			end,

			Disconnect = function(StoredValues)

				if StoredValues.Connection then
					StoredValues.Connection:Disconnect()
				end

				if StoredValues.Part then
					StoredValues.Part:Destroy()
				end

				table.clear(StoredValues)
			end,
