	local function Teleport(Player, OtherPlayer)
	
		local Result = {}
	
		local Character = Player.Character
		local OtherCharacter = OtherPlayer.Character
	
		if not Character then
			Result.Result = "Failed"
			Result.Message = "Local player has no Character."
			return Result
		end
	
		if not OtherCharacter then
			Result.Result = "Failed"
			Result.Message = "Target player has no Character."
			return Result
		end
	
		local HumanoidRootPart = Character:FindFirstChild("HumanoidRootPart")
		local OtherHumanoidRootPart = OtherCharacter:FindFirstChild("HumanoidRootPart")
	
		if not HumanoidRootPart then
			Result.Result = "Failed"
			Result.Message = "Local player missing HumanoidRootPart."
			return Result
		end
	
		if not OtherHumanoidRootPart then
			Result.Result = "Failed"
			Result.Message = "Target player missing HumanoidRootPart."
			return Result
		end
	
		HumanoidRootPart.CFrame = OtherHumanoidRootPart.CFrame
	
		Result.Result = "Success"
		Result.Message = "Teleport success."
	
		return Result
	end
	
	local function HasCanCollide(Instance)
		local Success, Result = pcall(function()
			return Instance.CanCollide
		end)
	
		return Success
	end
	
	local function Noclip(Player, Toggle)
	
		local Result = {}
	
		local Character = Player.Character
	
		if not Character then
			Result.Result = "Failed"
			Result.Message = "Local player has no Character."
			return Result
		end
		
		local NData = CommandData.Noclip.Data
		local StoredValues = NData.StoredValues
	
		for _, Part in ipairs(Character:GetDescendants()) do
			if HasCanCollide(Part) then
	
				if Toggle == true then
	
					if Part:GetAttribute("DefaultCanCollide") == nil then
						Part:SetAttribute(
							"DefaultCanCollide",
							Part.CanCollide
						)
					end
	
					Part.CanCollide = false
	
				else
	
					local DefaultValue =
						Part:GetAttribute("DefaultCanCollide")
	
					if DefaultValue ~= nil then
						Part.CanCollide = DefaultValue
						Part:SetAttribute("DefaultCanCollide", nil)
					end
	
				end
			end
		end
		
		Result.Result = "Success"
		
		if Toggle then
			StoredValues.Enabled = true
			Result.Message = "Noclip enabled."
		else
			StoredValues.Enabled = false
			Result.Message = "Noclip disabled."
		end
	
		return Result
	
	end
	
	local function AntiVoid(Player, Toggle)
	
		local Result = {}
	
		local Character = Player.Character
		local HumanoidRootPart = Character and Character:FindFirstChild("HumanoidRootPart")
	
		local Data = CommandData.AntiVoid.Data
		local StoredValues = Data.StoredValues
	
		if not Toggle then
	
			if not StoredValues.Part then
				Result.Result = "Failed"
				Result.Message = "AntiVoid isn't active."
				return Result
			end
	
			Data.Disconnect(StoredValues)
	
			Result.Result = "Success"
			Result.Message = "AntiVoid disabled."
			return Result
		end
	
		if not Character or not HumanoidRootPart then
			Result.Result = "Failed"
			Result.Message = "Local player missing HumanoidRootPart."
			return Result
		end
	
		if StoredValues.Part then
			Data.Disconnect(StoredValues)
		end
	
		local ConnectionData = Data.Connect(HumanoidRootPart)
	
		StoredValues.Part = ConnectionData.Part
		StoredValues.HumanoidRootPart = HumanoidRootPart
	
		Result.Result = "Success"
		Result.Message = "AntiVoid enabled."
	
		return Result
	end
	
	local function HipHeight(Player, Value, Toggle)
	
